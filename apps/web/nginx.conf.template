# Rendered at container start by the image's envsubst step: ${API_UPSTREAM} and
# ${NGINX_LOCAL_RESOLVERS} are filled in, nginx's own $variables are left alone.
server {
  listen 3000;
  root /usr/share/nginx/html;

  # Resolve the API host per request so nginx starts before the API and follows it when its IP changes.
  resolver ${NGINX_LOCAL_RESOLVERS} valid=10s ipv6=off;

  # The browser talks only to this origin; nginx forwards API calls, so no CORS is involved.
  location /api/ {
    set $api_upstream ${API_UPSTREAM};
    proxy_pass $api_upstream;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    # Matches the backend's multipart limit (spring.servlet.multipart.max-request-size).
    client_max_body_size 12m;
  }

  # Hashed build assets never change, so browsers may cache them for good.
  # ^~ keeps the extension rule below from taking these requests.
  location ^~ /assets/ {
    try_files $uri =404;
    add_header Cache-Control "public, max-age=31536000, immutable";
  }

  # The app shell must be revalidated so a deploy is picked up on the next load.
  location = /index.html {
    add_header Cache-Control "no-cache";
  }

  # Any other file request (mockServiceWorker.js, favicon, ...) must exist; never answer it with the app shell.
  location ~ \.[a-zA-Z0-9]+$ {
    try_files $uri =404;
  }

  # Everything else is an app route: serve the SPA and let the router decide.
  location / {
    try_files $uri /index.html;
  }
}
